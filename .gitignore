# ============================================================
#  智学平台 · Git 忽略规则
#  目标：源代码 / 课件 / 部署配置入库；
#        学生隐私数据 / 本机工具 / 运行时产物绝不入库。
# ============================================================

# ---- 学生隐私数据（含账号、进度、PII，绝不入库） ----
server/data/db.json
server/data/*.json

# ---- 运行时 / 缓存 / 日志 ----
.watch_status.json
__pycache__/
*.pyc
*.log

# ---- 本地 QA 截图 ----
.qa-screens/

# ---- 平台 / 编辑器文件 ----
.DS_Store
.AppleDouble
.AppleSingle
.idea/
.vscode/
*.swp

# ---- macOS 启动器 / 打包（含本机绝对路径，勿共享） ----
*.command
智学平台.app/

# ---- 开发工具目录（与静态服务 DENY 名单一致） ----
tools/

# ---- 环境变量 / 密钥（保险） ----
.env
.env.*
!.env.example

# ---- Node 依赖（零依赖项目，保险） ----
node_modules/

# ---- WorkBuddy 工作目录（含截图等本机产物，不入库） ----
.workbuddy/
